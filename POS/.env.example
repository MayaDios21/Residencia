# Ejemplo de las variables de entorno que usa el backend (config/settings.py).
# Sirve de referencia: los valores reales se definen en la terminal (ver
# GUIA_PRUEBAS_LOCAL.txt) o en el servidor. Nunca subir un archivo .env real.
#
# DJANGO_SECRET_KEY      Clave secreta de Django (obligatoria).
# DJANGO_DEBUG           True solo en desarrollo; en producción False.
# DJANGO_ALLOWED_HOSTS   Dominios desde los que se puede usar el backend.
# DATABASE_URL           Conexión a PostgreSQL; si falta se usa SQLite local.
# CORS_ALLOWED_ORIGINS   Direcciones del frontend que pueden llamar a la API.
# CSRF_TRUSTED_ORIGINS   Orígenes https extra para formularios de /admin/
#                        (en Vercel el dominio del proyecto se agrega solo).
#
# En Vercel: DATABASE_URL es la del pooler de Supabase en modo transacción
# (puerto 6543) con ?sslmode=require. DJANGO_ALLOWED_HOSTS y CORS casi no hacen
# falta porque el dominio de Vercel se agrega solo y frontend y API comparten
# dominio. Los valores reales se capturan en el panel de Vercel, nunca aquí.

DJANGO_SECRET_KEY=replace-with-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://db_user@db_host:5432/residencia
# Supabase: postgresql://postgres.<ref>:<contraseña>@<host-del-pooler>:6543/postgres?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:8080
