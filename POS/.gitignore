# Archivos y carpetas que Git no debe subir al repositorio: compilados de
# Python, secretos, bases de datos locales y archivos generados.
# Python
__pycache__/
*.py[cod]
*.sqlite3
.venv/
venv/

# Archivos de entorno y secretos
.env
.env.*
!.env.example

# Django y herramientas locales
staticfiles/
media/
.vscode/

# Dependencias y archivos compilados del frontend
node_modules/
dist/
build/
# Contexto local del proyecto (memoria entre sesiones, no se sube)
CONTEXTO_PROYECTO.md
